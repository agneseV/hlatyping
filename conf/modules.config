/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
    ]

    withName: CHECK_PAIRED {
        ext.args = ''
        publishDir = [ enabled: false ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: YARA_INDEX {
        publishDir = [ enabled: false ]
    }

    withName: YARA_MAPPER {
        ext.args   = '-e 3'
        publishDir = [ enabled: false ]
    }

    withName: OPTITYPE {
        ext.args = { "--enumerate ${params.optitype_enumerations} --beta ${params.optitype_beta}" }
        ext.args2 = {
            [
                'solver': params.optitype_solver,
                'unpaired_weight': params.optitype_unpaired_weight,
                'use_discordant': params.optitype_use_discordant
            ]
        }
        publishDir = [
            path: { "${params.outdir}/optitype" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HLAHD_INSTALL' {
        publishDir = [ enabled: false ]
    }

    withName: HLAHD {
        ext.args = '-m 50'
        publishDir = [
            path: { "${params.outdir}/hlahd/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: IMMUNOTYPE {
        ext.peptide_col_name = params.peptide_col_name
        publishDir = [
            path: { "${params.outdir}/immunotype" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HLALA_TYPING' {
        ext.args = '--graph PRG_MHC_GRCh38_withIMGT'
        publishDir = [
            path: { "${params.outdir}/hlala" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.endsWith('.bam') || filename.endsWith('.bam.bai') || filename.endsWith('.fastq')) return null
                filename
            },
        ]
    }

    withName: 'ARCASHLA_GENOTYPE' {
        ext.args = '-g A,B,C,E,G,H,J,K,L,V,Y,DRB1,DQA1,DQB1,DPA1,DPB1,DMA,DMB,DOA,DOB,DRA,DRB2,DRB3,DRB4,DRB5,DRB6,DRB7,DRB8,DRB9'
        publishDir = [path: "${params.outdir}/arcashla/", mode: 'copy']
        containerOptions = '--bind /b06x-isi/g703/g-i/immuno/Nextflow_Agnese/arcashla_dat:/usr/local/share/arcas-hla-0.6.0-2/dat'
    }
    withName: 'ARCASHLA_PARTIAL' {
        ext.args = '-g A,B,C,DPA1,DPB1,DQA1,DQB1,DRB1'
        publishDir = [path: "${params.outdir}/arcashla/partial/", mode: 'copy']
        containerOptions = '--bind /b06x-isi/g703/g-i/immuno/Nextflow_Agnese/arcashla_dat:/usr/local/share/arcas-hla-0.6.0-2/dat'
    }
    withName: 'ARCASHLA_MERGE' {
        publishDir = [path: "${params.outdir}/arcashla/partial/", mode: 'copy']
    }

    withName: '.*HLATYPING:SAMTOOLS_VIEW' {
        ext.args = '--output-fmt bam'
        ext.prefix = { "${meta.id}.hlala" }
        publishDir = [ enabled: false ]
    }

    withName: 'HLALA_PREPAREGRAPH' {
        publishDir = [ enabled: false ]
    }

    withName: '.*BAM_HLA_PREPROCESSING:SAMTOOLS_INDEX' {
        publishDir = [ enabled: false ]
    }

    withName: '.*BAM_HLA_PREPROCESSING:SAMTOOLS_VIEW_HLA' {
        ext.args   = '--output-fmt bam -P -F 0xD00'
        ext.prefix = { "${meta.id}.mhc" }
        publishDir = [ enabled: false ]
    }

    withName: '.*BAM_HLA_PREPROCESSING:SAMTOOLS_VIEW_UNMAPPED' {
        ext.args   = '--output-fmt bam -f 0xD -F 0xD00'
        ext.prefix = { "${meta.id}.unmap" }
        publishDir = [ enabled: false ]
    }

    withName: '.*BAM_HLA_PREPROCESSING:SAMTOOLS_MERGE' {
        ext.args   = '-c -p'
        ext.prefix = { "${meta.id}.hla" }
        publishDir = [ enabled: false ]
    }
    withName: 'WGET' {
        publishDir = [ enabled: false ]
    }

    withName: 'UNTAR' {
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_COLLATEFASTQ' {
        publishDir = [ enabled: false ]
    }

    withName: SPECHLA_EXTRACT {
        ext.args   = '-r hg38'
        publishDir = [ enabled: false ]
    }

    withName: SPECHLA_TYPING {
        ext.args = '-u 1 -p nonuse'
        publishDir = [
            path: { "${params.outdir}/spechla" },
            mode: params.publish_dir_mode
        ]
    }

    withName: SUMMARIZE_TYPING {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: CAT_FASTQ {
        publishDir = [
            path: { params.save_merged_fastq ? "${params.outdir}/fastq" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename.endsWith('.fastq.gz') && params.save_merged_fastq) ? filename : null }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }
}
